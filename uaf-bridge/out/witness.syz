#   - step_index=1 t=1 event=use
#   - step_index=2 t=2 event=escape
#   - step_index=3 t=3 event=cleanup
#   - step_index=4 t=4 event=fetch
#   - step_index=5 t=5 event=init_resource

# barriers:
#   - escape < fetch (Pointer must escape before later fetch/use chain.)
#   - free < use (Use-after-free requires free to occur before use.)

# predicates:
